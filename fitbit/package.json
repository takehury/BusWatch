{
  "name": "bus-watch-fitbit",
  "version": "1.0.0",
  "private": true,
  "description": "Автобусы для Fitbit OS: живые позиции и остановки",
  "scripts": {
    "test": "node test-core.mjs",
    "build": "npx fitbit-build",
    "sync-core": "cp core.mjs app/core.js"
  },
  "devDependencies": {
    "@fitbit/sdk": "^7.0.0",
    "@fitbit/sdk-cli": "^1.9.0"
  },
  "fitbit": {
    "appId": 0,
    "appType": "app",
    "appDisplayName": "Автобусы",
    "iconFile": "resources/icon.png",
    "wipeColor": "#0b1218",
    "requestedPermissions": [
      "access_internet",
      "access_location"
    ],
    "defaultLanguage": "ru-RU",
    "supportedLanguages": [
      "ru-RU"
    ],
    "projectType": "app",
    "appTimeout": 0
  }
}
