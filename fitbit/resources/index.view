<svg>
  <rect id="bg" x="0" y="0" width="100%" height="100%" fill="#0b1218" />

  <!-- шапка -->
  <text id="clock" x="0" y="0" fill="#7f97a8" font-size="18" text-anchor="middle">--:--</text>
  <text id="title" x="0" y="0" fill="#ffb020" font-size="16" text-anchor="middle" font-weight="bold">АВТОБУСЫ</text>
  <rect id="back" x="0" y="0" width="60" height="40" rx="8" fill="#16232e" />
  <text id="backLabel" x="0" y="0" fill="#cfe0ec" font-size="16" text-anchor="middle">‹</text>

  <!-- строки списка -->
  <rect id="r0" x="0" y="0" width="0" height="0" rx="10" fill="#16232e" />
